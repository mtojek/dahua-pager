# Give the Rust main task enough stack for standard library startup.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Reserve enough stack for ESP-IDF system and event tasks.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# Set the default stack size for Rust-created threads.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Use the largest standard single-app partition for the current firmware image.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
